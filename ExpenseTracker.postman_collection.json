{
  "info": {
    "name": "Expense Tracker API",
    "description": "Complete API collection for Expense Tracker - Spring Boot + JWT + MySQL",
    "_postman_id": "expense-tracker-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token",   "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "if (json.data && json.data.token) {",
                "  pm.collectionVariables.set('token', json.data.token);",
                "  console.log('Token saved:', json.data.token);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Income",
      "item": [
        {
          "name": "Get All Incomes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incomes",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Add Income",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/incomes",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50000.00,\n  \"source\": \"Salary\",\n  \"date\": \"2026-06-01\",\n  \"description\": \"Monthly salary June\"\n}"
            }
          }
        },
        {
          "name": "Update Income",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/incomes/1",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 55000.00,\n  \"source\": \"Salary\",\n  \"date\": \"2026-06-01\",\n  \"description\": \"Updated monthly salary\"\n}"
            }
          }
        },
        {
          "name": "Delete Income",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/incomes/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Get All Expenses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/expenses",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Add Expense - Food",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/expenses",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1500.00,\n  \"category\": \"Food\",\n  \"date\": \"2026-06-05\",\n  \"description\": \"Weekly groceries\"\n}"
            }
          }
        },
        {
          "name": "Add Expense - Travel",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/expenses",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 800.00,\n  \"category\": \"Travel\",\n  \"date\": \"2026-06-06\",\n  \"description\": \"Metro card recharge\"\n}"
            }
          }
        },
        {
          "name": "Add Expense - Bills",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/expenses",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 2500.00,\n  \"category\": \"Bills\",\n  \"date\": \"2026-06-07\",\n  \"description\": \"Electricity bill\"\n}"
            }
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/expenses/1",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1800.00,\n  \"category\": \"Food\",\n  \"date\": \"2026-06-05\",\n  \"description\": \"Updated groceries\"\n}"
            }
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/expenses/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    }
  ]
}
